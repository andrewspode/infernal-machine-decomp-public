new file mode 100644
index 0000000..dff5407
--- /dev/null
+++ b/src/ntheap.h
@@ -0,0 +1,74 @@
+#pragma once
+
+// Optional Windows NT heap model for HeapCreate'd heaps (WIBO_HEAP_MODEL=nt).
+//
+// Some 1990s tools depend on the addresses their heap returns: Intel C/C++ 4.0's mcpcom orders the operands
+// of commutative expressions by the address of their symbol records, so its generated code differs between
+// wibo's mimalloc arena (high addresses, size-class pages) and a real Windows heap. With this mode, heaps
+// created by HeapCreate behave like the NT backend allocator (RtlAllocateHeap without a front end):
+// 8-byte block headers and granularity, dedicated free lists for blocks under 1 KiB plus a size-ordered list,
+// splitting at the front, coalescing on free, segments reserved bottom-up through VirtualAlloc and committed
+// page by page, decommit of large free blocks, and blocks over the VirtualMemoryThreshold allocated directly.
+// The process heap keeps wibo's default allocator.
+
+#include "types.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace wibo {
+
+bool ntHeapModelEnabled();
+
+class NtHeap {
+  public:
+	NtHeap(DWORD flags, SIZE_T initialSize, SIZE_T maximumSize);
+	~NtHeap();
+	NtHeap(const NtHeap &) = delete;
+	NtHeap &operator=(const NtHeap &) = delete;
+
+	void *alloc(SIZE_T size, bool zero);
+	void *realloc(void *ptr, SIZE_T size, bool zero, bool inPlaceOnly);
+	bool free(void *ptr);
+	bool owns(const void *ptr) const;
+	SIZE_T size(const void *ptr) const;
+
+  private:
+	struct FreeBlock {
+		uintptr_t size;
+		uint64_t seq;
+	};
+	struct UsedBlock {
+		uintptr_t block;   // address of the HEAP_ENTRY (or of the VirtualAlloc'd region)
+		uintptr_t size;    // block size in bytes including the header (region size for VirtualAlloc'd blocks)
+		SIZE_T request;    // caller's size, returned by HeapSize
+		bool virtualBlock; // VirtualAlloc'd (over the threshold)
+	};
+	struct Segment {
+		uintptr_t base, end;
+		std::map<uintptr_t, uintptr_t> uncommitted; // start -> end
+	};
+
+	bool newSegment(uintptr_t reserve, uintptr_t firstBlockOffset);
